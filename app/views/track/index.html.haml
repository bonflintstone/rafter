.container
  %h1 Rafter

  - if @error
    .error= @error
  = form_with url: root_path, method: :get, class: 'track-form' do |form|
    = form.text_field :url, placeholder: "Just click raft to automatically paste!", value: @url, required: true, class: 'track-form_input'
    = form.submit "Raft!", class: 'track-form_submit', type: 'button'
    = form.submit "Share", class: "track-form_share", type: 'button'

:javascript
  const pasteButton = document.querySelector(".track-form_submit");
  const shareButton = document.querySelector(".track-form_share");
  const urlInput = document.querySelector(".track-form_input");

  const fillFromClipboard = async () => {
    urlInput.value = await navigator.clipboard.readText();
  }

  pasteButton.addEventListener("click", async () => {
    if (urlInput.value.trim() == "") await fillFromClipboard();

    urlInput.form.submit()
  });

  shareButton.addEventListener("click", async () => {
    if (urlInput.value.trim() == "") await fillFromClipboard();

    // submit to share action
    urlInput.form.action = "/share";
    urlInput.form.submit()
  });
